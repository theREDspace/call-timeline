{
  "$schema": "./node_modules/fallow/schema.json",
  // The engine loads plugin/hooks/register.tsx (plugin/hooks/hooks.json)
  "entry": ["plugin/hooks/register.tsx", "plugin/types/index.d.ts"],
  "ignorePatterns": [".claude/**", "plugin/.claude-plugin/types/**"],
  // `claude-code` is provided by the engine at runtime, not npm
  "ignoreDependencies": ["claude-code"],
  // `claude plugin test plugin` runs plugin/tests/. Declaring it as a test framework makes those files test
  // roots for coverage-gaps and CRAP, instead of plain entries that leave everything "untested".
  // The runner also loads plugin/hooks/register.tsx (via hooks.json) for every test file, which no
  // import shows, so it is a test root too: tests reach the pane through the engine, not imports.
  "framework": [
    {
      "name": "claude-plugin-test",
      "detection": { "type": "fileExists", "pattern": "plugin/tests/**/*.test.{ts,tsx}" },
      "entryPoints": ["plugin/tests/**/*.test.{ts,tsx}", "plugin/hooks/register.tsx"],
      "entryPointRole": "test"
    }
  ],
  // Long scenario tests branch on optional chains, not logic; keep them out of complexity findings.
  "health": {
    "ignore": ["plugin/tests/**"]
  }
}
